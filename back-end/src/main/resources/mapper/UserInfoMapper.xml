<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.backend.mapper.UserInfoMapper">
    <select id="selectByUserId" resultType="org.example.backend.entity.UserInfo">
        SELECT * FROM user_account WHERE user_id = #{userId}
    </select>
</mapper>
